# Copia este archivo como backend/.env y llena los valores.
# backend/.env está en .gitignore: nunca se sube al repo.

# Key gratuita de Google AI Studio: aistudio.google.com → "Get API key"
GEMINI_API_KEY=

# Modelos Flash de Gemini, separados por coma y en orden de preferencia.
# Si el primero está saturado ("high demand"), ia.py intenta el siguiente.
# El 11 nov 2026, gemini-3.8-flash y gemini-3.7-flash respondían 503 por demanda;
# gemini-3.5-flash respondía en ~3 s.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash

# Hora del "reloj" de la demo (HH:MM). Fija para que la demo siempre dé los
# mismos colores. Si se deja vacía, se usa 06:15.
PORTIX_HORA_ACTUAL=06:15
