# Copia este archivo como backend/.env y llena los valores.
# backend/.env está en .gitignore: nunca se sube al repo.

# Key gratuita de Google AI Studio: aistudio.google.com → "Get API key"
GEMINI_API_KEY=

# Modelos Flash de Gemini, separados por coma y en orden de preferencia.
# Si el primero está saturado ("high demand"), ia.py intenta el siguiente.
# El 11 nov 2026, gemini-3.8-flash y gemini-3.7-flash respondían 503 por demanda;
# gemini-3.5-flash respondía en ~3 s.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash

# Hora del "reloj" de la demo (HH:MM). Fija para que la demo siempre dé los
# mismos colores. Si se deja vacía, se usa 06:15.
PORTIX_HORA_ACTUAL=06:15

# --- Giro: avisos reales por SMS y llamada con Twilio (opcional) ---
# Si falta cualquiera de estos, los avisos se muestran como "Simulado".
# Cuenta de prueba: twilio.com/try-twilio → Account SID y Auth Token en la consola.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número que te asigna Twilio, en formato E.164 (ej. +15551234567)
TWILIO_FROM=
# Celular de alguien del equipo que aceptó usarlo (verificado en Twilio), en
# formato E.164: +52 y 10 dígitos, sin espacios. NUNCA se sube al repo.
TELEFONO_DEMO=
# Solo con la cuenta de PRUEBA de Twilio: solo deja mandar sus plantillas
# predefinidas. Con esto el SMS sale de verdad (suena el celular) usando esa
# plantilla, y el texto de PORTIX se muestra en pantalla como simulado.
# Con una cuenta completa, déjalo vacío y sale el texto de PORTIX.
TWILIO_PLANTILLA_PRUEBA=sms_appointment_reminders
# Voz de las llamadas (opcional). Polly.Mia = español de México.
TWILIO_VOZ=Polly.Mia
